{
  "name": "hackathon-mentor-dispatch-kit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "node scripts/dev.mjs --production",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm typecheck && cargo test --manifest-path backend/Cargo.toml --locked",
    "test:backend": "cargo test --manifest-path backend/Cargo.toml --locked"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@cloudflare/kumo": "2.9.2",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.0",
    "@tailwindcss/postcss": "4.3.0"
  }
}
